{
	// The repository scripts run on Bun, which executes TypeScript directly; this config only
	// type-checks them (`bun run check`). Browser callbacks passed to page.evaluate need DOM.
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts"]
}
