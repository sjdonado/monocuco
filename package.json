{
	"name": "monocuco",
	"private": true,
	"version": "1.3.0",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"deploy": "bun --bun vite build && bun --bun wrangler pages deploy",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json && bun --bun tsc -p scripts/tsconfig.json",
		"check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun --bun eslint . && bun --bun prettier --check .",
		"test:unit": "bun --bun vitest",
		"test": "bun run test:unit -- --run",
		"ci": "bun run check && bun run lint && bun run test",
		"format": "bun --bun prettier --write .",
		"add-word": "./scripts/add-word.ts",
		"build-data": "bun ./scripts/build-index.ts && bun ./scripts/generate-initial-words.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.3",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"daisyui": "^5.7.47",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"terser": "^5.51.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.145.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.49.0",
		"marked": "^18.0.14",
		"minisearch": "^7.2.0"
	}
}
